@tailwind base;
@tailwind components;
@tailwind utilities;

/* Base styles (fonts, colors, etc.) */
@layer base {
  :root {
    --color-primary: #803f9b;
    --color-background: #f7f6f2;
    --color-surface: #f7f6f2;
    --color-on-surface: #2e2f2d;
    --color-outline: #767774;

    --font-headline: "Epilogue", sans-serif;
    --font-body: "Plus Jakarta Sans", sans-serif;
    --font-label: "Space Grotesk", sans-serif;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-background);
    color: var(--color-on-surface);
  }

  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
}

/* Components (optional, but good structure) */
@layer components {
  .card-glow:hover {
    box-shadow: 0 0 20px rgba(128, 63, 155, 0.4),
                0 0 40px rgba(74, 222, 128, 0.2);
    border-color: #803F9B;
  }
}

/* Utilities */
@layer utilities {
  .hard-shadow {
    box-shadow: 4px 4px 0px 0px #2E2F2D;
  }

  .hard-shadow-primary {
    box-shadow: 4px 4px 0px 0px #803F9B;
  }

  .active-press:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  .dashed-connector {
    background-image: linear-gradient(to right, #2E2F2D 50%, transparent 50%);
    background-size: 10px 2px;
    background-repeat: repeat-x;
    height: 2px;
  }

  .dot-grid {
    background-image: radial-gradient(#2E2F2D 1px, transparent 1px);
    background-size: 32px 32px;
    background-color: #f7f6f2;
    background-attachment: fixed;
  }

  .dark .dot-grid {
    background-image: radial-gradient(#F7F6F2 1px, transparent 1px);
    background-color: #2e2f2d;
  }

  .animate-marquee {
    animation: marquee 20s linear infinite;
  }

  .animate-marquee-slow {
    animation: marquee 40s linear infinite;
  }

  .scroll-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scroll-hide::-webkit-scrollbar {
    display: none;
  }
}

/* Keyframes */
@keyframes marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}